# Cloudflare Worker URL that serves video metadata + streamable links.
# Copy this file to .env.local and put your real worker URL below for local dev.
# In production (Cloudflare Pages), set VITE_WORKER_URL in:
# Pages dashboard -> your project -> Settings -> Environment variables
VITE_WORKER_URL=https://your-worker-name.your-subdomain.workers.dev/
